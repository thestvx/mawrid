# Supabase (dashboard: https://supabase.com/dashboard)
# Create a "users" table: id (generated PK), firebase_uid (text, unique), email (text),
# name (text), role (text), phone (text), store_name (text), created_at (timestamptz)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Cloudinary (unsigned upload preset — in the dashboard you create an
# "unsigned" upload preset; these values are NOT secret)
VITE_CLOUDINARY_CLOUD_NAME=el5bm2tm
VITE_CLOUDINARY_UPLOAD_PRESET=Mawrid